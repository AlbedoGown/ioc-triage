# VirusTotal API v3 — https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# Лимит запросов к VirusTotal в минуту (free tier — 4; для премиум-ключа можно поднять)
VT_RATE_LIMIT_PER_MIN=4
# Сколько движков VT должно сработать для вердикта «вредоносный» (меньше — «подозрительный»)
VT_MALICIOUS_THRESHOLD=3
# AbuseIPDB API v2 — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# Kaspersky OpenTIP — https://opentip.kaspersky.com/token/
OPENTIP_API_KEY=
# Пауза под лимит OpenTIP, запросов в минуту (Kaspersky лимиты не публикует; пусто — без паузы)
OPENTIP_RATE_LIMIT_PER_MIN=
# Auth-Key abuse.ch (URLhaus, ThreatFox, MalwareBazaar) — бесплатно, https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
